// RUN: rm -f dynamic_failure.ll
// RUN: %mim %s
// RUN: %FileCheck %s --input-file=dynamic_failure.ll --check-prefix=LLVM
// RUN: clang dynamic_failure.ll -o %t -Wno-override-module
// RUN: (! %t 2>&1) | %FileCheck %s

// LLVM: c"dynamic failure message\00"
// LLVM: define internal void @.mimir_assert_
// LLVM: call void @abort()

plugin mem;
plugin runtime;
plugin core;
plugin compile;

extern lam _compile (): compile.Phase =
    let optimize = compile.phases tt (compile.beta_red, compile.eta_conv);
    compile.phases ff (
        optimize,
        compile.named "cps.conv",
        optimize,
        compile.lam_spec,
        compile.single_erasure,
        compile.branch_normalize,
        compile.ret_wrap,
        runtime.ll_emit,
    );

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let condition = core.icmp.sl (argc, 0I32);
    let m = runtime.assert (m, condition, "dynamic failure message");
    return (m, 0I32);

// CHECK: dynamic failure message
