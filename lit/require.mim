// RUN: %mim %s -o - | %FileCheck %s

plugin runtime;

extern lam static_success(): Nat =
    runtime.require (tt, "must hold") body where
        lam body(): Nat = 42;
    end;

extern lam dynamic(condition: Bool): Nat =
    runtime.require (condition, "dynamic precondition") body where
        lam body(): Nat = 7;
    end;

// CHECK: runtime.fail
// CHECK-LABEL: extern lam dynamic
// CHECK: runtime.static_check
// CHECK-LABEL: extern lam static_success
// CHECK-NOT: runtime.static_check
// CHECK-NOT: runtime.fail
// CHECK: 42
