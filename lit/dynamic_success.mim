// RUN: rm -f dynamic_success.ll
// RUN: %mim %s
// RUN: %FileCheck %s --input-file=dynamic_success.ll --check-prefix=LLVM
// RUN: clang dynamic_success.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 7

// LLVM: define internal void @.mimir_assert_
// LLVM: br i1 %condition, label %success, label %failure
// LLVM: call i32 @puts(ptr
// LLVM: call i32 @fflush(ptr null)
// LLVM: call void @abort()

plugin mem;
plugin runtime;
plugin core;
plugin compile;

extern lam _compile (): compile.Phase =
    let optimize = compile.phases tt (compile.beta_red, compile.eta_conv);
    compile.phases ff (
        optimize,
        compile.named "cps.conv",
        optimize,
        compile.lam_spec,
        compile.single_erasure,
        compile.branch_normalize,
        compile.ret_wrap,
        runtime.ll_emit,
    );

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let condition = core.icmp.sg (argc, 0I32);
    let m = runtime.assert (m, condition, "dynamic success");
    return (m, 7I32);
