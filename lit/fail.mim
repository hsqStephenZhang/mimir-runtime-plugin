// RUN: rm -f fail.ll
// RUN: %mim %s
// RUN: %FileCheck %s --input-file=fail.ll --check-prefix=LLVM
// RUN: clang fail.ll -o %t -Wno-override-module
// RUN: (! %t 2>&1) | %FileCheck %s

// LLVM: c"explicit failure msg\00"
// LLVM: call i32 @puts(ptr
// LLVM: call i32 @fflush(ptr null)
// LLVM: call void @abort()

plugin mem;
plugin runtime;
plugin compile;

extern lam _compile (): compile.Phase =
    let optimize = compile.phases tt (compile.beta_red, compile.eta_conv);
    compile.phases ff (
        optimize,
        compile.named "cps.conv",
        optimize,
        compile.lam_spec,
        compile.single_erasure,
        compile.branch_normalize,
        compile.ret_wrap,
        runtime.ll_emit,
    );

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let result = runtime.fail @(I32, 20) "explicit failure msg";
    return (m, result);

// CHECK: explicit failure msg
