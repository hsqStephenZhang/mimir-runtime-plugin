// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ok; test $? -eq 9
// RUN: (! %t 2>&1) | %FileCheck %s

plugin mem;
plugin runtime;
plugin core;
plugin compile;

extern lam _compile (): compile.Phase =
    let optimize = compile.phases tt (compile.beta_red, compile.eta_conv);
    compile.phases ff (
        optimize,
        compile.named "cps.conv",
        optimize,
        compile.lam_spec,
        compile.single_erasure,
        compile.branch_normalize,
        compile.ret_wrap,
        runtime.ll_emit,
    );

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let condition = core.icmp.sg (argc, 1I32);
    let result = runtime.require @(I32, 23) (condition, "require failure message") success where
        lam success(): I32 = 9I32;
    end;
    return (m, result);

// CHECK: require failure message
